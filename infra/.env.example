# ====================================================================
# eBPF EDR Alert Infrastructure Configuration
# Used by: local agent, K8s deployment (k8s/deploy.sh)
# ====================================================================

# Database for persistent alert storage and investigation
# Could be: Supabase, PostgreSQL, DynamoDB, etc.
# Format depends on backend (e.g., https://...supabase.co for Supabase)
DATABASE_URL=https://your-project.supabase.co
DATABASE_KEY=your-database-key

# Pub/Sub for real-time alert distribution and monitoring
# Could be: Redis, Kafka, RabbitMQ, etc.
# Format depends on backend (e.g., redis://host:port for Redis)
PUBSUB_ADDR=redis://default:password@host:6379
PUBSUB_KEY=optional-extra-key-if-needed

# K8s cluster info (optional, for workload enrichment in alerts)
# Used by DaemonSet to add context to alerts
CLUSTER_NAME=my-cluster
REGION=us-east-1
